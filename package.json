{
  "name": "etiquetas-api-nest",
  "version": "0.4.0",
  "description": "API de integração (NestJS) para consulta e envio de etiquetas de produtos do Sankhya (Origem) ao Sistema de Destino",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:agrupamento": "ts-node scripts/testar-agrupamento.ts",
    "docs:export": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "oracledb": "^6.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "typescript": "^5.4.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "express": "^4.19.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
